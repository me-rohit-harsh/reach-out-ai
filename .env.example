# Groq API Key (for LLM generation via groq-sdk)
GROQ_API_KEY=your_groq_api_key_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# LinkedIn Credentials
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password_here

# Path to your CV file (PDF or Text)
CV_PATH=./my_cv.pdf

# Max pages to scrape per URL (default: 10)
MAX_PAGES=10

# Test mode: scrape and list emails but do NOT send (true/false)
TEST_MODE=false
